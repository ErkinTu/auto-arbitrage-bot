# PostgreSQL
POSTGRES_DB=car_analytics
POSTGRES_USER=car_user
POSTGRES_PASSWORD=change_me_to_a_long_password
POSTGRES_PORT=5432
# Интерфейс публикации порта БД. По умолчанию только localhost хоста.
# Контейнеры ходят в БД по внутренней сети (postgres:5432), опубликованный
# порт нужен только для psql/GUI с самого хоста. Наружу не открывать.
POSTGRES_HOST=127.0.0.1
DATABASE_URL=postgresql+psycopg://car_user:change_me_to_a_long_password@localhost:5432/car_analytics

# Mashina.kg adapter
MASHINA_API_URL=https://mashina.kg/api/mbank-proxy/v1/ads/listings
# Lalafo.kg adapter (fresh-only) и дневной курс USD/KGS для цен в сомах
LALAFO_BASE_URL=https://lalafo.kg
LALAFO_FRESH_PAGE_SIZE=50
# Раздельные паузы lalafo: лента марки — тяжелый запрос, карточка — лёгкий GET.
# При ответе 429 парсер сам удваивает detail-паузу до конца цикла.
LALAFO_FEED_DELAY_SECONDS=5.0
LALAFO_DETAIL_DELAY_SECONDS=0.5
# Прокси только для lalafo: Cloudflare lalafo блокирует датацентровые IP
# (с AWS — 403 «Just a moment»), нужен резидентный/мобильный выход.
# Пусто = напрямую (локально работает без прокси).
# Форматы: http://user:pass@host:port | socks5://127.0.0.1:1080
LALAFO_PROXY_URL=
NBKR_RATES_URL=https://www.nbkr.kg/XML/daily.xml
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=2.0
REQUEST_RETRY_ATTEMPTS=5
REQUEST_RETRY_BACKOFF_SECONDS=10.0
USER_AGENT=CarAnalyticsMVP/0.1 (contact: your-email@example.com)

# Synchronization
ALLOWED_BRANDS=BMW,Audi,Toyota,Kia
MISSING_FULL_SCANS_BEFORE_DEACTIVATION=2
DEFAULT_PAGE_SIZE=100
DEFAULT_MAX_PAGES=5
DEFAULT_MAX_ITEMS=500
DEFAULT_SYNC_INTERVAL_MINUTES=60

# API
API_CACHE_TTL_SECONDS=300
# Интерфейс публикации порта API. По умолчанию только localhost хоста:
# локально доступен полностью, на сервере (bot+back, без фронта) наружу закрыт.
# Открыть наружу осознанно (например, за reverse-proxy): API_HOST=0.0.0.0.
API_HOST=127.0.0.1
# Разрешённые origin'ы фронта (CORS). Не является границей безопасности —
# защита от внешнего доступа обеспечивается bind'ом порта на 127.0.0.1.
CORS_ORIGINS=http://localhost:5173

# Telegram bot
TELEGRAM_BOT_TOKEN=
# id закрытой группы/канала вида -100...; бот должен быть добавлен туда админом
TELEGRAM_ACCESS_CHAT_ID=
BOT_FRESH_INTERVAL_MINUTES=10
BOT_FRESH_PAGE_SIZE=20
BOT_FRESH_PERIOD=1d
BOT_NEW_LOOKBACK_MINUTES=180
# Catch-up: если ВСЯ fresh-страница новая (пропуск между циклами/простой),
# дочитать до N дополнительных страниц
BOT_CATCHUP_MAX_PAGES=3
# Уведомлять только если объявление ОПУБЛИКОВАНО на источнике не раньше N часов
# назад: VIP-поднятые старые объявления в «свежей» ленте — не «новинки»
BOT_MAX_LISTING_AGE_HOURS=12
BOT_BELOW_AVG_FACTOR=0.95
BOT_BELOW_AVG_MIN_SAMPLES=5
BOT_ACCESS_CACHE_TTL_SECONDS=600
# Потолок фильтров на пользователя (визард /add_filter отказывает сверх лимита).
# Действует только на СОЗДАНИЕ: у кого фильтров уже больше (лимит снижали с 10),
# старые продолжают работать, пока он сам их не удалит.
BOT_MAX_FILTERS_PER_USER=5
# Потолок пушей одному чату за цикл (защита рассылки от блокировки; 0 = без лимита)
BOT_MAX_NOTIFICATIONS_PER_USER_PER_CYCLE=50
# Группировка: столько и больше объявлений ОДНОЙ марки за цикл одному человеку
# уезжают одним сообщением-списком вместо N карточек. 0 = выключено.
# Замер на проде: обычный цикл — 5 сообщений на человека, первый цикл после
# ночной паузы — в среднем 28 (максимум 55); значение 3 сжимает утренний залп
# в несколько раз. Минус: у списка нет кнопки «не показывать такие».
BOT_GROUP_MIN_LISTINGS=0
# Защита контента: убирает «Переслать»/«Сохранить» у сообщений бота и включает
# блокировку скриншотов там, где клиент умеет (Android). iOS/Desktop/Web скриншоты
# НЕ блокируют — гарантии нет. false = отключить защиту всем.
BOT_PROTECT_CONTENT=true
# Кому пересылка РАЗРЕШЕНА: telegram id через запятую (свои/админы/партнёры).
# Пусто = защита для всех. Узнать id: @userinfobot. Применяется после рестарта бота.
BOT_SHARE_WHITELIST_IDS=

# Подписка / Finik (finik.kg, Web SDK). Пока FINIK_API_KEY/FINIK_ACCOUNT_ID или
# PUBLIC_BASE_URL пусты — подписка спит: /subscribe отвечает «недоступно»,
# доступ к боту гейтится только группой (как раньше). Суперюзеры = члены группы,
# обычные пользователи = активная подписка.
FINIK_API_KEY=
FINIK_ACCOUNT_ID=
# beta | prod — выбирает и хост acquiring, и публичный ключ Finik для проверки
# webhook. Сначала обкатать на beta, потом переключить.
FINIK_ENV=beta
# Приватный ключ ФАЙЛОМ: положить в ./secrets/finik_private.pem (chmod 600),
# каталог смонтирован в контейнер bot как /run/secrets (в git ключ не попадает).
# Создать: openssl genrsa -out finik_private.pem 2048
#          openssl rsa -in finik_private.pem -pubout > finik_public.pem
# Публичный (finik_public.pem) загрузить в кабинет Finik при создании API-ключа
# типа «Веб-клиент» (WEB).
FINIK_PRIVATE_KEY_PATH=/run/secrets/finik_private.pem
# name_en: имя, которое плательщик видит на странице оплаты. ЛАТИНИЦЕЙ.
FINIK_QR_NAME=Car Analytics Bot
# Срок жизни ссылки на оплату (endDate у QR), секунды.
FINIK_PAYMENT_LIFETIME_SECONDS=3600
# Домен для Caddy (авто-HTTPS) — публичный вход для webhook Finik.
# Должен резолвиться на сервер; порты 80/443 открыты. Пусто = Caddy не нужен.
PAYMENTS_DOMAIN=
# Публичный HTTPS-адрес (за Caddy) для webhook/redirect Finik; без хвостового /
# Обычно https://<PAYMENTS_DOMAIN>
PUBLIC_BASE_URL=
# Username бота без @ — тогда после оплаты Finik вернёт юзера сразу в бота
# (вместо нашей технической страницы /api/v1/payments/success).
BOT_USERNAME=
# Обкатка оплаты на проде: пока список не пуст, /subscribe работает ТОЛЬКО для
# этих telegram_id, остальные видят «оплата скоро» и платёж им не заводится.
# Пейвол после триала в этом режиме тоже не зовёт в /subscribe. Пусто = оплата
# открыта всем (боевой режим). Узнать свой id: @userinfobot.
SUBSCRIPTION_TESTER_IDS=
SUBSCRIPTION_PRICE_KGS=2000
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_REMINDER_DAYS_BEFORE=1
# Finik сообщает только об успешных оплатах — неоплаченные гасим сами.
PAYMENT_PENDING_TTL_HOURS=6

# --- Админ-панель ------------------------------------------------------------
# Публичный адрес панели, напр. https://admin.example.kg (без хвостового /).
# ПУСТО = вход выключен целиком: команда /admin в боте молчит даже для админа.
# Права выдаются только SQL: UPDATE bot_users SET is_superuser=true WHERE ...
ADMIN_PANEL_URL=
# Сколько минут живёт ссылка входа. Она одноразовая в любом случае.
ADMIN_LOGIN_TOKEN_TTL_MINUTES=5
# Сколько часов живёт открытая сессия. Секрет для неё не нужен: сессия — строка
# в таблице admin_sessions, а не подписанный токен, поэтому её можно отозвать.
ADMIN_SESSION_TTL_HOURS=12

# Бесплатный период по кнопке в /start. Выдаётся ОДИН раз на telegram_id
# (метка trial_started_at не обнуляется никогда). 0 = триал выключен: кнопки в
# онбординге нет, доступ как раньше — группа ИЛИ подписка.
TRIAL_DAYS=3
# Рефералка: «пригласи N друзей — получи +M дней». Друг засчитывается только
# после активации триала (клик по ссылке бесплатен, триал — одноразовый).
# Работает поверх триала: при TRIAL_DAYS=0 выключена.
REFERRAL_FRIENDS_PER_BONUS=3
REFERRAL_BONUS_DAYS=7
# Сколько бонусов максимум одному пригласившему. 1 = «+7 дней один раз»:
# телеграм-ботов бот не регистрирует, но мультиаккаунтинг живым человеком не
# ловится ничем, а без потолка 30 приглашённых = 70 бесплатных дней.
# 0 = без ограничения.
REFERRAL_MAX_BONUSES=1

# Расписание (локальное время SCHEDULER_TIMEZONE)
SCHEDULER_TIMEZONE=Asia/Bishkek
# Fresh-циклы бота только в этом окне; 24 = до полуночи
BOT_ACTIVE_START_HOUR=8
BOT_ACTIVE_END_HOUR=24
# Полная сверка по выходным: половина марок в субботу, половина в воскресенье
FULL_SCAN_HOUR=2
FULL_SCAN_BRAND_PAUSE_SECONDS=60
FULL_SCAN_PAGE_SIZE=100
FULL_SCAN_MAX_PAGES=100
FULL_SCAN_MAX_ITEMS=10000
# Пересчет daily_market_stats (только сегодня): каждый час, но лишь в окне
# активности бота [BOT_ACTIVE_START_HOUR, BOT_ACTIVE_END_HOUR) — ночью нет
# свежих данных и не работает matching, market_average берёт последнюю дату
STATS_REBUILD_START_HOUR=8
STATS_REBUILD_INTERVAL_HOURS=1
# Свежесть данных (у lalafo нет full-scan): в агрегаты идут объявления,
# виденные в ленте не позже N дней; не виденные дольше STALE_LISTING_DAYS
# worker раз в сутки помечает неактивными
STATS_MAX_LAST_SEEN_DAYS=30
STALE_LISTING_DAYS=30
# Отсев выбросов цены по когорте «модель+год» при построении агрегатов: в
# когортах >= OUTLIER_MIN_COHORT исключаются цены вне [median/K, median*K]
OUTLIER_PRICE_MEDIAN_MULTIPLE=4.0
OUTLIER_MIN_COHORT=5
# Точечный валидатор lalafo (раз в сутки): карточки объявлений, не виденных
# N дней; HTTP 410 -> деактивация, 200 -> продление last_seen_at
LALAFO_VALIDATE_AFTER_DAYS=3
LALAFO_VALIDATE_MAX_PER_RUN=500
