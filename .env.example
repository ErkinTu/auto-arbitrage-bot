# PostgreSQL
POSTGRES_DB=car_analytics
POSTGRES_USER=car_user
POSTGRES_PASSWORD=change_me_to_a_long_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://car_user:change_me_to_a_long_password@localhost:5432/car_analytics

# Mashina.kg adapter
MASHINA_API_URL=https://mashina.kg/api/mbank-proxy/v1/ads/listings
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=2.0
REQUEST_RETRY_ATTEMPTS=5
REQUEST_RETRY_BACKOFF_SECONDS=10.0
USER_AGENT=CarAnalyticsMVP/0.1 (contact: your-email@example.com)

# Synchronization
ALLOWED_BRANDS=BMW,Audi,Toyota,Kia
MISSING_FULL_SCANS_BEFORE_DEACTIVATION=2
DEFAULT_PAGE_SIZE=100
DEFAULT_MAX_PAGES=5
DEFAULT_MAX_ITEMS=500
DEFAULT_SYNC_INTERVAL_MINUTES=60

# API
API_CACHE_TTL_SECONDS=300

# Telegram bot
TELEGRAM_BOT_TOKEN=
# id закрытой группы/канала вида -100...; бот должен быть добавлен туда админом
TELEGRAM_ACCESS_CHAT_ID=
BOT_FRESH_INTERVAL_MINUTES=25
BOT_FRESH_PERIOD=1d
BOT_NEW_LOOKBACK_MINUTES=60
BOT_BELOW_AVG_FACTOR=0.95
BOT_BELOW_AVG_MIN_SAMPLES=5
BOT_ACCESS_CACHE_TTL_SECONDS=600
