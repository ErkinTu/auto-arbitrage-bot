# PostgreSQL
POSTGRES_DB=car_analytics
POSTGRES_USER=car_user
POSTGRES_PASSWORD=change_me_to_a_long_password
POSTGRES_PORT=5432
# Интерфейс публикации порта БД. По умолчанию только localhost хоста.
# Контейнеры ходят в БД по внутренней сети (postgres:5432), опубликованный
# порт нужен только для psql/GUI с самого хоста. Наружу не открывать.
POSTGRES_HOST=127.0.0.1
DATABASE_URL=postgresql+psycopg://car_user:change_me_to_a_long_password@localhost:5432/car_analytics

# Mashina.kg adapter
MASHINA_API_URL=https://mashina.kg/api/mbank-proxy/v1/ads/listings
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=2.0
REQUEST_RETRY_ATTEMPTS=5
REQUEST_RETRY_BACKOFF_SECONDS=10.0
USER_AGENT=CarAnalyticsMVP/0.1 (contact: your-email@example.com)

# Synchronization
ALLOWED_BRANDS=BMW,Audi,Toyota,Kia
MISSING_FULL_SCANS_BEFORE_DEACTIVATION=2
DEFAULT_PAGE_SIZE=100
DEFAULT_MAX_PAGES=5
DEFAULT_MAX_ITEMS=500
DEFAULT_SYNC_INTERVAL_MINUTES=60

# API
API_CACHE_TTL_SECONDS=300
# Интерфейс публикации порта API. По умолчанию только localhost хоста:
# локально доступен полностью, на сервере (bot+back, без фронта) наружу закрыт.
# Открыть наружу осознанно (например, за reverse-proxy): API_HOST=0.0.0.0.
API_HOST=127.0.0.1
# Разрешённые origin'ы фронта (CORS). Не является границей безопасности —
# защита от внешнего доступа обеспечивается bind'ом порта на 127.0.0.1.
CORS_ORIGINS=http://localhost:5173

# Telegram bot
TELEGRAM_BOT_TOKEN=
# id закрытой группы/канала вида -100...; бот должен быть добавлен туда админом
TELEGRAM_ACCESS_CHAT_ID=
BOT_FRESH_INTERVAL_MINUTES=10
BOT_FRESH_PAGE_SIZE=20
BOT_FRESH_PERIOD=1d
BOT_NEW_LOOKBACK_MINUTES=60
BOT_BELOW_AVG_FACTOR=0.95
BOT_BELOW_AVG_MIN_SAMPLES=5
BOT_ACCESS_CACHE_TTL_SECONDS=600

# Расписание (локальное время SCHEDULER_TIMEZONE)
SCHEDULER_TIMEZONE=Asia/Bishkek
# Fresh-циклы бота только в этом окне; 24 = до полуночи
BOT_ACTIVE_START_HOUR=8
BOT_ACTIVE_END_HOUR=24
# Полная сверка по выходным: половина марок в субботу, половина в воскресенье
FULL_SCAN_HOUR=2
FULL_SCAN_BRAND_PAUSE_SECONDS=60
FULL_SCAN_PAGE_SIZE=100
FULL_SCAN_MAX_PAGES=100
FULL_SCAN_MAX_ITEMS=10000
# Пересчет daily_market_stats: каждые 8 часов, сетка 9:00 / 17:00 / 01:00
# (не 2:00, чтобы не пересекаться с полной сверкой по выходным)
STATS_REBUILD_START_HOUR=9
STATS_REBUILD_INTERVAL_HOURS=8
