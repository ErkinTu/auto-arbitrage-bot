# Caddy: единственный публичный вход. Два сайта, и они НЕ пересекаются:
#   {$PAYMENTS_DOMAIN} — вебхук Finik;
#   {$ADMIN_DOMAIN}    — админ-панель.
# Всё остальное API (оценка, каталог, /docs) остаётся закрытым на 127.0.0.1.
#
# Домены берутся из .env; авто-HTTPS Let's Encrypt требует, чтобы имя
# резолвилось на этот сервер и были открыты порты 80/443.

# --- Платежи ---------------------------------------------------------------
# Host наверх передаётся как пришёл (дефолт reverse_proxy) — это важно: `Host`
# входит в подпись webhook Finik, при подмене проверка не сойдётся. Этот блок
# трогать без нужды нельзя: через него идут боевые оплаты.
{$PAYMENTS_DOMAIN} {
	@payments path /api/v1/payments/*
	handle @payments {
		reverse_proxy api:8000
	}
	# Любой другой путь наружу не открываем.
	handle {
		respond "Not found" 404
	}
}

# --- Админ-панель ----------------------------------------------------------
# Отдельным доменом, а не путём на домене платежей: подпись Finik завязана на
# Host, и мешать в один блок боевые оплаты с панелью — лишний риск.
#
# Наружу открыт РОВНО один префикс API — /api/v1/admin/*, за которым стоит
# гейт current_admin. Публичные ручки (catalog, market, dashboard, estimate)
# сюда не проксируются: панель ходит в их копии под /admin/*.
{$ADMIN_DOMAIN} {
	@admin_api path /api/v1/admin/*
	handle @admin_api {
		reverse_proxy api:8000
	}

	# Всё остальное под /api/ наружу закрыто — и отвечает честным 404, а не
	# index.html: иначе SPA-фолбэк отдавал бы HTML на запрос JSON, и разбираться,
	# «почему ручка вернула страницу», пришлось бы дважды.
	@api_rest path /api/*
	handle @api_rest {
		respond "Not found" 404
	}

	# Статика панели: собранный фронт (pnpm build → dist/), смонтированный
	# томом. try_files нужен из-за history-режима роутера: /users/42 — это не
	# файл, отдать надо index.html и дать роутеру разобраться самому.
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# Заголовки, которые ничего не стоят и закрывают целый класс глупостей.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

# --- Сайт (Nuxt) + внешний API для него -------------------------------------
# Один домен: страницы отдаёт Nuxt (web:3000), а браузер ходит в API по тому же
# origin (`/api/v1/*`) — поэтому CORS сайту не нужен. Наружу — только белый
# список: read-only ручки (GET/HEAD/OPTIONS) и `auth/*` (вход/выход, POST/DELETE
# с проверкой Origin на стороне api: нужен SITE_URL в .env). `admin/*` и
# `payments/*` остаются на своих доменах, /docs и /openapi.json сюда не попадают
# (API_DOCS_ENABLED=false). Лимиты частоты держит само приложение
# (core/ratelimit.py) по реальному IP — Caddy подставляет его в X-Forwarded-For.
# Пока сайт «тихий» (не анонсирован): noindex в заголовке и robots.txt с запретом.
# При открытии — убрать оба (см. docs/planning/SITE_TODO.md).
{$SITE_DOMAIN} {
	@public_api {
		method GET HEAD OPTIONS
		path /api/v1/public/* /api/v1/catalog/* /api/v1/dashboard/* /api/v1/market/* /api/v1/estimate /api/v1/price-trend
	}
	@auth_api path /api/v1/auth/*
	@health path /health
	@api_rest path /api/*

	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	handle @health {
		reverse_proxy api:8000
	}
	handle @public_api {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			# Висящий бэкенд не должен держать соединения клиента бесконечно.
			transport http {
				response_header_timeout 15s
			}
		}
	}
	handle @auth_api {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			transport http {
				response_header_timeout 15s
			}
		}
	}
	# Остальной /api/* наружу закрыт: честный 404, а не страница сайта.
	handle @api_rest {
		respond "Not found" 404
	}
	handle {
		reverse_proxy web:3000 {
			transport http {
				response_header_timeout 30s
			}
		}
	}
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
