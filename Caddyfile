# Caddy: единственный публичный вход. Два сайта, и они НЕ пересекаются:
#   {$PAYMENTS_DOMAIN} — вебхук Finik;
#   {$ADMIN_DOMAIN}    — админ-панель.
# Всё остальное API (оценка, каталог, /docs) остаётся закрытым на 127.0.0.1.
#
# Домены берутся из .env; авто-HTTPS Let's Encrypt требует, чтобы имя
# резолвилось на этот сервер и были открыты порты 80/443.

# --- Платежи ---------------------------------------------------------------
# Host наверх передаётся как пришёл (дефолт reverse_proxy) — это важно: `Host`
# входит в подпись webhook Finik, при подмене проверка не сойдётся. Этот блок
# трогать без нужды нельзя: через него идут боевые оплаты.
{$PAYMENTS_DOMAIN} {
	@payments path /api/v1/payments/*
	handle @payments {
		reverse_proxy api:8000
	}
	# Любой другой путь наружу не открываем.
	handle {
		respond "Not found" 404
	}
}

# --- Админ-панель ----------------------------------------------------------
# Отдельным доменом, а не путём на домене платежей: подпись Finik завязана на
# Host, и мешать в один блок боевые оплаты с панелью — лишний риск.
#
# Наружу открыт РОВНО один префикс API — /api/v1/admin/*, за которым стоит
# гейт current_admin. Публичные ручки (catalog, market, dashboard, estimate)
# сюда не проксируются: панель ходит в их копии под /admin/*.
{$ADMIN_DOMAIN} {
	@admin_api path /api/v1/admin/*
	handle @admin_api {
		reverse_proxy api:8000
	}

	# Всё остальное под /api/ наружу закрыто — и отвечает честным 404, а не
	# index.html: иначе SPA-фолбэк отдавал бы HTML на запрос JSON, и разбираться,
	# «почему ручка вернула страницу», пришлось бы дважды.
	@api_rest path /api/*
	handle @api_rest {
		respond "Not found" 404
	}

	# Статика панели: собранный фронт (pnpm build → dist/), смонтированный
	# томом. try_files нужен из-за history-режима роутера: /users/42 — это не
	# файл, отдать надо index.html и дать роутеру разобраться самому.
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# Заголовки, которые ничего не стоят и закрывают целый класс глупостей.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
